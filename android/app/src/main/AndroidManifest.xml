<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Solo para Cuéntame un gasto con la voz: se reconoce dentro del teléfono y el audio no se guarda ni sale. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Para mostrar el nombre de la app del banco que mandó el aviso (solo apps con ícono en el inicio). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Tema">

        <meta-data android:name="asset_statements" android:resource="@string/asset_statements" />

        <!-- Primera pantalla: explica y activa la lectura automática; si ya está activa, abre la app enseguida. -->
        <!-- Tarea propia: así, al tocar el ícono, siempre pasa por aquí y
             entrega a la página los avisos que llegaron mientras estaba en segundo plano. -->
        <activity
            android:name=".BienvenidaActivity"
            android:exported="true"
            android:taskAffinity="co.fintelligente.app.entrada"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/accesos" />
        </activity>

        <!-- Abre Finti (la web) a pantalla completa y le pasa los avisos leídos. -->
        <activity
            android:name=".InicioActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <meta-data android:name="android.support.customtabs.trusted.DEFAULT_URL" android:value="@string/sitio" />
            <meta-data android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR" android:resource="@color/primario" />
            <meta-data android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR" android:resource="@color/blanco" />
            <meta-data android:name="android.support.customtabs.trusted.FALLBACK_STRATEGY" android:value="customtabs" />
        </activity>

        <!-- Widget de la pantalla de inicio: micrófono y escribir. -->
        <receiver
            android:name=".WidgetEfectivo"
            android:exported="true"
            android:label="@string/widget_nombre">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_efectivo_info" />
        </receiver>

        <!-- Widget "Hoy puedes gastar" (sin cifra a la vista; un toque abre el Inicio) -->
        <receiver
            android:name=".WidgetHoy"
            android:exported="true"
            android:label="@string/hoy_nombre">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_hoy_info" />
        </receiver>

        <!-- Cuéntame un gasto con la voz (botón Efectivo y micrófono de la página). -->
        <activity
            android:name=".VozActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Tu privacidad: qué se lee, pausa y registro de lo que pasó con los avisos. -->
        <activity android:name=".PrivacidadActivity" android:exported="false" android:screenOrientation="portrait" />

        <!-- Enlaces desde la web: fintelligente://ajustes -->
        <activity
            android:name=".AccionActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="fintelligente" />
            </intent-filter>
        </activity>

        <!-- Lee los avisos de los bancos dentro del celular. Nada sale del teléfono. -->
        <service
            android:name=".LectorNotificaciones"
            android:exported="true"
            android:label="@string/lector_nombre"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Botón Efectivo en la barra de notificaciones (ajustes rápidos). -->
        <service
            android:name=".EfectivoTile"
            android:exported="true"
            android:icon="@drawable/ic_finti_boton"
            android:label="@string/boton_efectivo"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="false" />
        </service>

        <!-- Para que los recordatorios de la web lleguen como notificaciones de la app. -->
        <service
            android:name="com.google.androidbrowserhelper.trusted.DelegationService"
            android:enabled="true"
            android:exported="true">
            <meta-data android:name="android.support.customtabs.trusted.SMALL_ICON" android:resource="@drawable/ic_notif" />
            <intent-filter>
                <action android:name="android.support.customtabs.trusted.TRUSTED_WEB_ACTIVITY_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
    </application>
</manifest>
