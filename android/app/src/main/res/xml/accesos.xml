<?xml version="1.0" encoding="utf-8"?>
<!-- Al mantener presionado el ícono de Finti -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:shortcutId="efectivo_gasto" android:enabled="true" android:icon="@drawable/ic_atajo_gasto"
        android:shortcutShortLabel="@string/acceso_gasto" android:shortcutLongLabel="@string/acceso_gasto_largo">
        <intent android:action="android.intent.action.VIEW" android:data="fintelligente://efectivo/gasto"
            android:targetPackage="co.fintelligente.app" android:targetClass="co.fintelligente.app.AccionActivity"/>
    </shortcut>
    <shortcut android:shortcutId="efectivo_ingreso" android:enabled="true" android:icon="@drawable/ic_atajo_ingreso"
