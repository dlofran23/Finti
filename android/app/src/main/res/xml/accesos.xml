    <shortcut android:shortcutId="privacidad" android:enabled="true" android:icon="@drawable/ic_atajo_privacidad"
        android:shortcutShortLabel="@string/acceso_privacidad" android:shortcutLongLabel="@string/acceso_privacidad_largo">
